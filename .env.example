# App defaults: localhost, explicit simulated model profile, real local embeddings.
AEGIS_MODE=simulated
AEGIS_HOME=.runtime
AEGIS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
AEGIS_PRIMARY_URL=http://127.0.0.1:11435/v1
AEGIS_PRIMARY_MODEL=qwen3:1.7b
AEGIS_SECONDARY_URL=http://127.0.0.1:11435/v1
AEGIS_SECONDARY_MODEL=qwen3:1.7b
# Real independent endpoint URLs/keys remain server-side.
AEGIS_PRIMARY_KEY=
AEGIS_SECONDARY_KEY=
AEGIS_ADMIN_KEY=
AEGIS_REDIS_URL=
AEGIS_INPUT_PER_MILLION=0
AEGIS_OUTPUT_PER_MILLION=0
# Local-only trace persistence is the default; set both to export to Langfuse.
AEGIS_OTLP_ENDPOINT=
AEGIS_OTLP_HEADERS=
AEGIS_LANGFUSE_URL=http://localhost:3000
# Official SDK path (preferred for Langfuse; don't also enable direct OTLP to it).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Generate privately before starting the optional LiteLLM Docker service.
LITELLM_MASTER_KEY=
